# BrandClave Aggregator Environment Configuration

# Mistral API (for embeddings)
MISTRAL_API_KEY=your_mistral_api_key_here

# Database paths
DATABASE_URL=sqlite:///./data/brandclave.db
CHROMA_PERSIST_DIR=./data/chroma

# Embedding configuration
# Options: "mistral" or "local" (sentence-transformers)
EMBEDDING_PROVIDER=mistral

# Scraping settings
SCRAPER_USER_AGENT=BrandClave-Aggregator/1.0

# Logging
LOG_LEVEL=INFO
# Log output format: "json" (structured, production default) or "text" (human-readable)
LOG_FORMAT=json

# Error tracking (optional). Requires `pip install sentry-sdk[fastapi]`;
# leave blank to disable Sentry entirely.
SENTRY_DSN=

# Auth: secret used to sign JWT access tokens. Set to a long random string in
# production; if left unset an ephemeral secret is generated at boot and all
# sessions are invalidated on restart.
JWT_SECRET=

# Redis (optional - caching works without it)
REDIS_URL=redis://localhost:6379/0

# Scheduler
SCHEDULER_ENABLED=true
# Minutes between adaptive POMDP scrape runs
ADAPTIVE_SCRAPE_INTERVAL_MINUTES=30

# Pre-warm heavy services (JAX JIT) at startup. Keep false on low-memory
# hosts (e.g. Render free tier); true trades slower boot for fast first requests.
PREWARM_SERVICES=false

# VERSES Genius Active Inference API
GENIUS_API_URL=https://your-agent-url.agents.genius.verses.ai
GENIUS_API_KEY=your_genius_api_key_here
GENIUS_AGENT_ID=your_agent_id_here
GENIUS_LICENSE_KEY=your_license_key_here

# Bluesky (AT Protocol). Public search is WAF-blocked; an authenticated
# session is required. Use an APP PASSWORD (Settings -> Privacy and security
# -> App passwords), never the account password.
BLUESKY_HANDLE=your_handle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# OpenAI: image generation for brand concept renders (Build a Brand -> Visualise)
OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-1.5
